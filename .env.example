# OCR provider: gemini (default) or ollama
OCR_PROVIDER=gemini
# Remote sync provider: bestdori (default) or fake
REMOTE_DATA_PROVIDER=bestdori
# Optional runtime mode label.
BANGSTATS_ENV=production

# Gemini OCR settings
GOOGLE_API_KEY=your_google_api_key_here
# Optional: comma-separated list for rate-limit rotation.
# GOOGLE_API_KEY=key1,key2,key3
GEMINI_MODEL=gemini-3.1-flash-lite-preview

# Ollama OCR settings (used when OCR_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llava

# General runtime settings
LOG_LEVEL=INFO
REMOTE_REQUEST_RETRIES=3
REMOTE_REQUEST_TIMEOUT=10
SCAN_MASTER_KEY=
SCAN_SERVER_FOLDER_WHITELIST=
SCAN_MAX_FILES_PER_USER=10000
SCAN_MAX_AGE_DAYS=90
SCAN_MAX_USER_STORAGE_MB=5000
DEV_SIMULATE_SCREENSHOT_LOCATIONS=false
DEV_SIMULATED_SERVER_FOLDER_ROOT=storage/dev/simulated_server_folders
DEV_SIMULATED_CLIENT_UPLOAD_SOURCE_ROOT=storage/dev/simulated_client_sources

# Fake scanner settings (used when OCR_PROVIDER=fake)
FAKE_SCAN_DELAY_MS=200
FAKE_SCAN_ERROR_RATE=15
FAKE_SCAN_ERROR_WEIGHTS=note_errors:40,not_found_errors:30,fast_slow_errors:15,max_combo_errors:10,live_errors:5
FAKE_SCAN_PROFILE=mixed
FAKE_SCAN_SEED=
FAKE_TIME_SPAN_DAYS=90
