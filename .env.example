# OCR provider: gemini (default) or ollama
OCR_PROVIDER=gemini

# Gemini OCR settings
GOOGLE_API_KEY=your_google_api_key_here
# Optional: comma-separated list for rate-limit rotation.
# GOOGLE_API_KEY=key1,key2,key3
GEMINI_MODEL=gemini-3.1-flash-lite-preview

# Ollama OCR settings (used when OCR_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llava

# General runtime settings
LOG_LEVEL=INFO
REMOTE_REQUEST_RETRIES=3
REMOTE_REQUEST_TIMEOUT=10
