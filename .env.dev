BANGSTATS_ENV=dev
BANGSTATS_DB_PATH=storage/bangstats_dev.db
OCR_PROVIDER=fake
REMOTE_DATA_PROVIDER=fake
FAKE_SCAN_DELAY_MS=200
FAKE_SCAN_ERROR_RATE=15
FAKE_SCAN_ERROR_WEIGHTS=note_errors:40,not_found_errors:30,fast_slow_errors:15,max_combo_errors:10,live_errors:5
FAKE_SCAN_PROFILE=mixed
FAKE_SCAN_SEED=42
FAKE_TIME_SPAN_DAYS=90
SCAN_MASTER_KEY=dev_master_key
SCAN_SERVER_FOLDER_WHITELIST=
SCAN_MAX_FILES_PER_USER=10000
SCAN_MAX_AGE_DAYS=90
SCAN_MAX_USER_STORAGE_MB=5000
DEV_SIMULATE_SCREENSHOT_LOCATIONS=true
DEV_SIMULATED_SERVER_FOLDER_ROOT=storage/dev/simulated_server_folders
DEV_SIMULATED_CLIENT_UPLOAD_SOURCE_ROOT=storage/dev/simulated_client_sources
LOG_LEVEL=DEBUG
